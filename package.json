{
  "name": "dsh-workspace-proxy",
  "version": "1.0.0",
  "description": "Per-workspace outbound proxy routing for DeepSeek Harness: each proxy applies to the workspaces you bind it to, with health checks and a direct fallback",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "NingbingHG",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proxy",
    "http-proxy",
    "workspace",
    "egress"
  ],
  "homepage": "https://github.com/NingbingHG/dsh-workspace-proxy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NingbingHG/dsh-workspace-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/NingbingHG/dsh-workspace-proxy/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
